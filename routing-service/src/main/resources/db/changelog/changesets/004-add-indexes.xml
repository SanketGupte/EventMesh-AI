<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-add-indexes" author="EventMesh">
        <!-- Event Log Indexes -->
        <createIndex tableName="event_log" indexName="idx_event_log_event_id">
            <column name="event_id"/>
        </createIndex>

        <createIndex tableName="event_log" indexName="idx_event_log_event_type">
            <column name="event_type"/>
        </createIndex>

        <createIndex tableName="event_log" indexName="idx_event_log_status">
            <column name="status"/>
        </createIndex>

        <createIndex tableName="event_log" indexName="idx_event_log_created_at">
            <column name="created_at"/>
        </createIndex>

        <createIndex tableName="event_log" indexName="idx_event_log_correlation_id">
            <column name="correlation_id"/>
        </createIndex>

        <!-- Routing Rule Indexes -->
        <createIndex tableName="routing_rule_entity" indexName="idx_routing_rule_event_type">
            <column name="event_type"/>
        </createIndex>

        <createIndex tableName="routing_rule_entity" indexName="idx_routing_rule_active">
            <column name="active"/>
        </createIndex>

        <!-- API Key Indexes -->
        <createIndex tableName="api_key" indexName="idx_api_key_api_key">
            <column name="api_key"/>
        </createIndex>

        <createIndex tableName="api_key" indexName="idx_api_key_active">
            <column name="active"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

